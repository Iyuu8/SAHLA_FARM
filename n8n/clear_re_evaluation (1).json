      "id": "b0c76b68-bf5b-4daf-a6af-e41c6dfda6c5",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst actuators = input.actuators || [];\nconst adr = input.meta.adr;\n\n// We use the services endpoint to preserve the UI functionality in HA\nconst BASE_URL = `http://${adr}:8123/api/services/input_datetime/set_datetime`;\n\n// A date guaranteed to be in the past\nconst PAST_DATETIME = \"2000-01-01 00:00:00\"; \n\nconst result = [];\n\nfor (const actuator of actuators) {\n  if (actuator.classification === \"NOW-RE-EVALUATING\") {\n    const type = actuator.type; // 'pump' or 'fan'\n\n    // 1. Clear the re-evaluation START time\n    result.push({\n      json: {\n        url: BASE_URL,\n        body: {\n          entity_id: `input_datetime.${type}_re_evaluation_start`,\n          datetime: PAST_DATETIME\n        }\n      }\n    });\n\n    // 2. Clear the re-evaluation END time\n    result.push({\n      json: {\n        url: BASE_URL,\n        body: {\n          entity_id: `input_datetime.${type}_re_evaluation_end`,\n          datetime: PAST_DATETIME\n        }\n      }\n    });\n  }\n}\n\n// If no actuators are \"NOW-RE-EVALUATING\", this returns an empty array.\n// In n8n, an empty array means the next HTTP Request node simply won't run.\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
